<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <!-- Adicione o link para o seu CSS aqui -->
    <style>
        .container { max-width: 1000px; margin: 0 auto; padding: 20px; font-family: sans-serif; }
        .table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        .table th, .table td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        .table th { background-color: #f4f4f4; }
        .btn { padding: 8px 12px; text-decoration: none; border-radius: 4px; border: none; cursor: pointer; color: white;}
        .btn-primary { background-color: #0056b3; }
        .btn-warning { background-color: #f0ad4e; color: black; }
        .btn-danger { background-color: #d9534f; }
        .header-actions { display: flex; justify-content: space-between; align-items: center; }
    </style>
</head>
<body>
    <div class="container">
        <nav>
            <a href="/dashboard">Voltar ao Dashboard</a> | 
            <a href="/lotes">Lotes</a>
        </nav>
        
        <div class="header-actions">
            <h1>Gestão de Hemocomponentes</h1>
            <a href="/hemocomponentes/novo" class="btn btn-primary">+ Novo Hemocomponente</a>
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Lote Origem</th>
                    <th>Tipo</th>
                    <th>Volume (ml)</th>
                    <th>Validade</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <% if (hemocomponentes && hemocomponentes.length > 0) { %>
                    <% hemocomponentes.forEach(function(item) { %>
                        <tr>
                            <td><%= item.id %></td>
                            <td><%= item.codigo_lote || item.lote_id %></td>
                            <td><%= item.tipo %></td>
                            <td><%= item.volume_ml %></td>
                            <td><%= new Date(item.data_validade).toLocaleDateString('pt-BR') %></td>
                            <td>
                                <strong><%= item.status %></strong>
                            </td>
                            <td>
                                <a href="/hemocomponentes/editar/<%= item.id %>" class="btn btn-warning">Editar</a>
                                
                                <% if (item.status !== 'Descartado') { %>
                                    <form action="/hemocomponentes/descartar/<%= item.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Tem certeza que deseja descartar esta bolsa?');">
                                        <button type="submit" class="btn btn-danger">Descartar</button>
                                    </form>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="7" style="text-align: center;">Nenhum hemocomponente encontrado.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</body>
</html>
