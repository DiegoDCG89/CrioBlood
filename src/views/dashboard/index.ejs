<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    
    <!-- Fonte Monoespaçada para estética de Terminal -->
    <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <!-- Tailwind via CDN com Configuração Customizada -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'matte-black': '#090a0c',
                        'dark-slate': '#1a1c23',
                        'cyber-yellow': '#fcee09',
                        'electric-purple': '#b026ff',
                        'danger-red': '#ff2a2a'
                    },
                    fontFamily: {
                        mono: ['"Share Tech Mono"', 'monospace'],
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-matte-black text-gray-300 font-mono min-h-screen p-8" style="background-image: linear-gradient(rgba(26, 28, 35, 0.8) 1px, transparent 1px), linear-gradient(90deg, rgba(26, 28, 35, 0.8) 1px, transparent 1px); background-size: 30px 30px;">
    
    <div class="max-w-5xl mx-auto">
        <!-- Header -->
        <header class="flex justify-between items-end border-b-2 border-cyber-yellow pb-4 mb-8">
            <div>
                <h1 class="text-4xl text-cyber-yellow tracking-widest uppercase uppercase drop-shadow-[0_0_8px_rgba(252,238,9,0.5)]">Sistema CrioBlood</h1>
                <p class="text-electric-purple mt-2">Operador ativo: <%= usuario ? usuario.nome : 'Desconhecido' %></p>
            </div>
            <nav class="space-x-4">
                <a href="/hemocomponentes" class="text-gray-400 hover:text-cyber-yellow transition-colors">Hemocomponentes</a>
                <a href="/lotes" class="text-gray-400 hover:text-cyber-yellow transition-colors">Lotes</a>
                <a href="/usuarios" class="text-gray-400 hover:text-cyber-yellow transition-colors">Usuários</a>
            </nav>
        </header>

        <!-- Container do Gráfico (com estilo de painel de controle) -->
        <div class="bg-dark-slate/90 border border-electric-purple p-6 shadow-[0_0_15px_rgba(176,38,255,0.15)] relative">
            <div class="absolute top-0 left-0 w-2 h-full bg-electric-purple"></div>
            <h2 class="text-xl text-electric-purple mb-6 uppercase tracking-wider">Volume em Estoque (ml)</h2>
            <canvas id="estoqueChart"></canvas>
        </div>
    </div>

    <!-- Script do Chart.js Mantido -->
    <script>
        const labels = <%- typeof chartLabels !== 'undefined' ? chartLabels : '[]' %>;
        const dataValues = <%- typeof chartData !== 'undefined' ? chartData : '[]' %>;

        if (labels.length > 0) {
            const ctx = document.getElementById('estoqueChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Volume (ml)',
                        data: dataValues,
                        backgroundColor: 'rgba(252, 238, 9, 0.8)',
                        borderColor: '#b026ff',
                        borderWidth: 2,
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { labels: { color: '#e0e0e0', font: { family: "'Share Tech Mono', monospace" } } } },
                    scales: {
                        y: { ticks: { color: '#e0e0e0', font: { family: "'Share Tech Mono', monospace" } }, grid: { color: '#333' } },
                        x: { ticks: { color: '#e0e0e0', font: { family: "'Share Tech Mono', monospace" } }, grid: { color: '#333' } }
                    }
                }
            });
        }
    </script>
</body>
</html>
